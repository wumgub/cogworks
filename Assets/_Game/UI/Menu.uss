.menu-root {
    position: absolute;
    left: 0;
    right: 0;
    top: 0;
    bottom: 0;
}

.overlay {
    position: absolute;
    left: 0;
    right: 0;
    top: 0;
    bottom: 0;
    align-items: center;
    justify-content: center;
    background-color: rgba(14, 10, 8, 0.72);
}

.panel {
    width: 380px;
    padding: 20px 22px;
    background-color: rgb(36, 28, 24);
    border-width: 2px;
    border-color: rgb(120, 90, 48);
    border-radius: 6px;
}

.panel--small {
    width: 280px;
}

.title {
    font-size: 34px;
    -unity-font-style: bold;
    -unity-text-align: middle-center;
    color: rgb(240, 180, 60);
    letter-spacing: 6px;
}

.title--small {
    font-size: 22px;
    letter-spacing: 2px;
}

.subtitle {
    -unity-text-align: middle-center;
    color: rgb(176, 160, 140);
    font-size: 12px;
    margin-bottom: 8px;
}

.section {
    margin-top: 12px;
    margin-bottom: 2px;
    font-size: 11px;
    color: rgb(176, 160, 140);
    -unity-font-style: bold;
}

.row {
    flex-direction: row;
    align-items: center;
}

.grow {
    flex-grow: 1;
}

.btn {
    height: 32px;
    margin: 3px 0;
    background-color: rgb(60, 46, 36);
    border-width: 1px;
    border-color: rgb(110, 84, 50);
    border-radius: 3px;
    color: rgb(238, 230, 218);
    font-size: 13px;
}

.row > .field {
    margin-right: 4px;
}

.gap-left {
    margin-left: 4px;
}

.btn:hover {
    background-color: rgb(78, 60, 46);
    border-color: rgb(190, 150, 90);
}

.btn:active {
    background-color: rgb(40, 31, 26);
}

.btn:disabled {
    opacity: 0.45;
}

.btn--primary {
    background-color: rgb(150, 105, 30);
    border-color: rgb(240, 180, 60);
    color: rgb(255, 248, 230);
    -unity-font-style: bold;
}

.btn--primary:hover {
    background-color: rgb(175, 125, 40);
}

.btn--quiet {
    margin-top: 10px;
    background-color: rgba(0, 0, 0, 0);
    border-color: rgba(0, 0, 0, 0);
    color: rgb(176, 160, 140);
}

.field {
    margin: 3px 0;
    height: 32px;
}

.field > #unity-text-input {
    background-color: rgb(26, 20, 18);
    border-color: rgb(110, 84, 50);
    color: rgb(240, 232, 220);
    font-size: 13px;
    padding-left: 8px;
}

.status {
    margin-top: 8px;
    min-height: 16px;
    white-space: normal;
    -unity-text-align: middle-center;
    color: rgb(240, 200, 120);
    font-size: 12px;
}

.session-info {
    position: absolute;
    top: 8px;
    left: 10px;
    padding: 4px 8px;
    background-color: rgba(26, 20, 18, 0.8);
    border-radius: 3px;
    color: rgb(238, 230, 218);
    font-size: 12px;
}

.toggle {
    margin: 2px 0 4px 0;
    color: rgb(214, 204, 188);
    font-size: 12px;
}

.toggle > Label {
    color: rgb(214, 204, 188);
    min-width: 0;
}

.code {
    font-size: 18px;
    -unity-font-style: bold;
    -unity-text-align: middle-center;
    color: rgb(246, 210, 120);
    letter-spacing: 3px;
    background-color: rgb(26, 20, 18);
    border-radius: 3px;
    height: 32px;
    margin: 3px 0;
}

.setting {
    margin: 6px 0;
}

.setting Label {
    color: rgb(224, 212, 196);
    min-width: 110px;
    font-size: 12px;
}

.panel--help {
    width: 560px;
    max-height: 90%;
}

.help-scroll {
    max-height: 440px;
    margin: 6px 0;
}

.help-text {
    white-space: normal;
    font-size: 13px;
    color: rgb(230, 220, 206);
}
