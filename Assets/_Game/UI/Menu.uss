.menu-root {
    position: absolute;
    left: 0;
    right: 0;
    top: 0;
    bottom: 0;
}

.overlay {
    position: absolute;
    left: 0;
    right: 0;
    top: 0;
    bottom: 0;
    align-items: center;
    justify-content: center;
    background-color: rgba(14, 10, 8, 0.78);
}

.panel {
    width: 440px;
    padding: 26px 30px 26px 30px;
}

.panel--small {
    width: 340px;
}

.panel--help {
    width: 640px;
    max-height: 92%;
}

.logo {
    width: 432px;
    height: 80px;
    align-self: center;
    background-image: url("../Art/UI/ui_logo.png");
    -unity-background-scale-mode: scale-to-fit;
}

.title {
    font-size: 24px;
    -unity-text-align: middle-center;
    color: rgb(250, 220, 140);
    margin-bottom: 4px;
}

.title--small {
    align-self: center;
}

.subtitle {
    -unity-text-align: middle-center;
    color: rgb(214, 196, 168);
    font-size: 8px;
    margin-bottom: 10px;
}

.section {
    margin-top: 14px;
    margin-bottom: 4px;
    font-size: 8px;
    color: rgb(226, 190, 120);
}

.row {
    flex-direction: row;
    align-items: center;
}

.grow {
    flex-grow: 1;
}

.btn {
    height: 36px;
    margin: 3px 0;
}

.gap-left {
    margin-left: 6px;
}

.row > .field {
    margin-right: 6px;
}

.btn--quiet {
    margin-top: 12px;
    background-image: none;
    color: rgb(200, 184, 160);
}

.btn--quiet:hover {
    background-image: none;
    color: rgb(250, 220, 140);
}

.field {
    margin: 3px 0;
    height: 36px;
}

.status {
    margin-top: 10px;
    min-height: 16px;
    white-space: normal;
    -unity-text-align: middle-center;
    color: rgb(250, 210, 130);
    font-size: 8px;
}

.session-info {
    position: absolute;
    top: 10px;
    left: 10px;
    padding: 6px 14px 8px 14px;
    font-size: 8px;
}

.toggle {
    margin: 4px 0;
}

.toggle Label {
    color: rgb(226, 214, 192);
    font-size: 8px;
    min-width: 0;
    margin-left: 6px;
}

.code {
    font-size: 24px;
    -unity-text-align: middle-center;
    color: rgb(250, 220, 140);
    letter-spacing: 4px;
    height: 40px;
    margin: 3px 0;
}

.setting {
    margin: 8px 0;
}

.setting Label {
    color: rgb(226, 214, 192);
    min-width: 130px;
    font-size: 8px;
}

.help-scroll {
    max-height: 460px;
    margin: 8px 0;
}

.help-text {
    white-space: normal;
    font-size: 8px;
    color: rgb(236, 224, 202);
}
