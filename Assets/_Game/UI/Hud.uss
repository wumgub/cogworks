.hud-root {
    position: absolute;
    left: 0;
    right: 0;
    top: 0;
    bottom: 0;
    align-items: center;
    padding-top: 12px;
    padding-bottom: 12px;
}

.spacer {
    flex-grow: 1;
}

.toast {
    padding: 6px 14px;
    font-size: 14px;
    color: rgb(255, 240, 200);
    background-color: rgba(26, 20, 18, 0.85);
    border-radius: 4px;
    border-width: 1px;
    border-color: rgb(240, 180, 60);
}

.hover-info {
    margin-bottom: 4px;
    padding: 3px 8px;
    font-size: 12px;
    color: rgb(236, 226, 210);
    background-color: rgba(26, 20, 18, 0.75);
    border-radius: 3px;
}

.selected-name {
    font-size: 15px;
    -unity-font-style: bold;
    color: rgb(245, 240, 225);
    margin-bottom: 4px;
    -unity-text-outline-width: 1px;
    -unity-text-outline-color: rgb(26, 20, 18);
}

.hotbar {
    flex-direction: row;
    padding: 4px;
    background-color: rgba(26, 20, 18, 0.88);
    border-width: 2px;
    border-color: rgb(96, 72, 40);
    border-radius: 4px;
}

.slot {
    width: 52px;
    height: 52px;
    margin: 2px;
    align-items: center;
    justify-content: center;
    background-color: rgb(48, 38, 32);
    border-width: 2px;
    border-color: rgb(96, 72, 40);
    border-radius: 2px;
}

.slot:hover {
    border-color: rgb(176, 150, 110);
}

.slot--selected {
    background-color: rgb(72, 60, 36);
    border-color: rgb(240, 180, 60);
}

.slot--selected:hover {
    border-color: rgb(255, 205, 100);
}

.slot-icon {
    width: 32px;
    height: 32px;
    -unity-background-scale-mode: scale-to-fit;
}

.slot-key {
    position: absolute;
    left: 3px;
    top: 0;
    font-size: 11px;
    color: rgb(204, 194, 180);
}

.hint {
    margin-top: 5px;
    font-size: 11px;
    color: rgba(240, 232, 220, 0.65);
    -unity-text-outline-width: 1px;
    -unity-text-outline-color: rgba(26, 20, 18, 0.8);
}

.slot-count {
    position: absolute;
    right: 3px;
    bottom: 1px;
    font-size: 11px;
    -unity-font-style: bold;
    color: rgb(240, 240, 245);
    -unity-text-outline-width: 1px;
    -unity-text-outline-color: rgb(10, 10, 12);
}

.slot--empty > .slot-icon {
    opacity: 0.35;
}

.minimap {
    position: absolute;
    top: 10px;
    right: 10px;
    padding: 3px;
    background-color: rgba(26, 20, 18, 0.9);
    border-width: 2px;
    border-color: rgb(150, 110, 50);
    border-radius: 4px;
    align-items: center;
}

.minimap-image {
    width: 160px;
    height: 160px;
    -unity-background-scale-mode: stretch-to-fill;
}

.minimap-coords {
    margin-top: 2px;
    font-size: 10px;
    color: rgb(214, 204, 188);
}
