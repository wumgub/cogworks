.hud-root {
    position: absolute;
    left: 0;
    right: 0;
    top: 0;
    bottom: 0;
    align-items: center;
    padding-top: 12px;
    padding-bottom: 10px;
}

.spacer {
    flex-grow: 1;
}

.toast {
    padding: 8px 18px 10px 18px;
    font-size: 16px;
    color: rgb(255, 238, 196);
}

.hover-info {
    margin-bottom: 6px;
    padding: 6px 14px 8px 14px;
    font-size: 8px;
    color: rgb(240, 228, 206);
}

.selected-name {
    margin-bottom: 4px;
    padding: 4px 18px 6px 18px;
}

.hotbar {
    flex-direction: row;
    padding: 14px 20px;
}

.slot {
    width: 48px;
    height: 48px;
    margin: 2px;
    align-items: center;
    justify-content: center;
    background-image: url("../Art/UI/ui_slot.png");
    -unity-slice-left: 5; -unity-slice-right: 5; -unity-slice-top: 5; -unity-slice-bottom: 5;
    -unity-slice-scale: 2px;
}

.slot:hover {
    background-image: url("../Art/UI/ui_slot_hover.png");
}

.slot--selected, .slot--selected:hover {
    background-image: url("../Art/UI/ui_slot_selected.png");
}

.slot-icon {
    width: 32px;
    height: 32px;
    -unity-background-scale-mode: scale-to-fit;
}

.slot--empty > .slot-icon {
    opacity: 0.35;
}

.slot-key {
    position: absolute;
    left: 5px;
    top: 3px;
    font-size: 8px;
    color: rgb(226, 190, 120);
    -unity-text-outline-width: 1px;
    -unity-text-outline-color: rgb(14, 10, 8);
}

.slot-count {
    position: absolute;
    right: 5px;
    bottom: 3px;
    font-size: 8px;
    color: rgb(255, 248, 230);
    -unity-text-outline-width: 1px;
    -unity-text-outline-color: rgb(14, 10, 8);
}

.hint {
    margin-top: 6px;
    font-size: 8px;
    color: rgba(240, 228, 206, 0.75);
    -unity-text-outline-width: 1px;
    -unity-text-outline-color: rgba(14, 10, 8, 0.8);
}

.minimap {
    position: absolute;
    top: 10px;
    right: 10px;
    padding: 8px 8px 6px 8px;
    align-items: center;
}

.minimap-image {
    width: 160px;
    height: 160px;
    -unity-background-scale-mode: stretch-to-fill;
}

.minimap-coords {
    margin-top: 4px;
    font-size: 8px;
    color: rgb(226, 210, 184);
}
