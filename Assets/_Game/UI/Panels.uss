.panels-root {
    position: absolute;
    left: 0;
    right: 0;
    top: 0;
    bottom: 0;
    align-items: center;
    justify-content: center;
    /* Keep windows clear of the hotbar. */
    padding-top: 12px;
    padding-bottom: 110px;
}

.window {
    width: 452px;
    max-height: 100%;
    padding: 18px 22px 22px 22px;
}

.window--wide {
    width: 780px;
}

.window-header {
    flex-direction: row;
    align-items: center;
    justify-content: space-between;
    margin-bottom: 6px;
}

.window-title {
    font-size: 16px;
}

.close-btn {
    width: 32px;
    height: 32px;
    padding: 0;
    background-image: url("../Art/UI/ui_close.png");
    background-color: rgba(0, 0, 0, 0);
    border-width: 0;
    color: rgba(0, 0, 0, 0);
    font-size: 1px;
}

.close-btn:hover {
    background-image: url("../Art/UI/ui_close_hover.png");
}

.columns {
    flex-direction: row;
}

.column {
    width: 392px;
}

.column--grow {
    flex-grow: 1;
    flex-shrink: 1;
    width: auto;
    margin-left: 14px;
}

.section-label {
    margin-top: 10px;
    margin-bottom: 4px;
    font-size: 8px;
    color: rgb(226, 190, 120);
}

.hint-line {
    font-size: 8px;
    color: rgb(200, 184, 160);
    white-space: normal;
    margin-bottom: 6px;
}

.status-line {
    font-size: 16px;
    color: rgb(246, 236, 214);
}

.network-line {
    font-size: 8px;
    color: rgb(140, 200, 240);
}

.grid {
    flex-direction: row;
    flex-wrap: wrap;
}

.grid--10 {
    width: 380px;
}

.item-slot {
    width: 36px;
    height: 36px;
    margin: 1px;
    align-items: center;
    justify-content: center;
    background-image: url("../Art/UI/ui_slot.png");
    -unity-slice-left: 5; -unity-slice-right: 5; -unity-slice-top: 5; -unity-slice-bottom: 5;
    -unity-slice-scale: 2px;
}

.item-slot:hover {
    background-image: url("../Art/UI/ui_slot_hover.png");
}

.item-slot--big {
    width: 44px;
    height: 44px;
}

.item-icon {
    width: 24px;
    height: 24px;
    -unity-background-scale-mode: scale-to-fit;
}

.item-slot--big .item-icon {
    width: 32px;
    height: 32px;
}

.item-count {
    position: absolute;
    right: 3px;
    bottom: 1px;
    font-size: 8px;
    color: rgb(255, 248, 230);
    -unity-text-outline-width: 1px;
    -unity-text-outline-color: rgb(14, 10, 8);
}

.labeled-slot {
    align-items: center;
    margin-right: 12px;
}

.labeled-slot > Label {
    font-size: 8px;
    color: rgb(206, 188, 160);
    margin-top: 2px;
}

.row {
    flex-direction: row;
    align-items: center;
    flex-wrap: wrap;
}

.machine-body {
    margin-top: 8px;
    padding: 10px;
    background-image: url("../Art/UI/ui_frame.png");
    -unity-slice-left: 8; -unity-slice-right: 8; -unity-slice-top: 8; -unity-slice-bottom: 8;
    -unity-slice-scale: 2px;
}

.bar {
    height: 16px;
    margin: 4px 0;
    padding: 4px 4px;
    flex-grow: 1;
    background-image: url("../Art/UI/ui_bar_track.png");
    -unity-slice-left: 3; -unity-slice-right: 3; -unity-slice-top: 3; -unity-slice-bottom: 3;
    -unity-slice-scale: 2px;
}

.bar-fill {
    height: 100%;
    background-image: url("../Art/UI/ui_bar_fill.png");
    -unity-slice-left: 2; -unity-slice-right: 2; -unity-slice-top: 2; -unity-slice-bottom: 2;
    -unity-slice-scale: 1px;
}

.bar-fill--fuel {
    background-image: url("../Art/UI/ui_bar_fill_fuel.png");
}

.bar-fill--research {
    background-image: url("../Art/UI/ui_bar_fill_research.png");
}

.bar-label {
    font-size: 8px;
    color: rgb(214, 196, 168);
    width: 96px;
}

.craft-list {
    max-height: 360px;
}

.craft-row {
    flex-direction: row;
    align-items: center;
    padding: 4px 6px 4px 10px;
    margin-bottom: 2px;
    background-image: url("../Art/UI/ui_row.png");
    -unity-slice-left: 4; -unity-slice-right: 4; -unity-slice-top: 4; -unity-slice-bottom: 4;
    -unity-slice-scale: 2px;
}

.craft-row:hover {
    background-image: url("../Art/UI/ui_row_hover.png");
}

.craft-row--unaffordable {
    opacity: 0.5;
}

.craft-text {
    flex-grow: 1;
    flex-shrink: 1;
    margin-left: 8px;
}

.craft-name {
    font-size: 16px;
    color: rgb(246, 236, 214);
    white-space: normal;
}

.craft-inputs {
    font-size: 8px;
    color: rgb(200, 184, 160);
    white-space: normal;
}

.queue {
    flex-direction: row;
    flex-wrap: wrap;
    min-height: 40px;
}

.recipe-grid {
    flex-direction: row;
    flex-wrap: wrap;
    margin-bottom: 6px;
}

.recipe-btn {
    width: 38px;
    height: 38px;
    margin: 1px;
    align-items: center;
    justify-content: center;
    background-image: url("../Art/UI/ui_slot.png");
    -unity-slice-left: 5; -unity-slice-right: 5; -unity-slice-top: 5; -unity-slice-bottom: 5;
    -unity-slice-scale: 2px;
}

.recipe-btn:hover {
    background-image: url("../Art/UI/ui_slot_hover.png");
}

.recipe-btn--selected, .recipe-btn--selected:hover {
    background-image: url("../Art/UI/ui_slot_selected.png");
}

.action-btn {
    height: 32px;
    margin-top: 8px;
}

.tech-list {
    max-height: 430px;
}

.tech-row {
    padding: 8px 10px 8px 14px;
    margin-bottom: 4px;
    background-image: url("../Art/UI/ui_row.png");
    -unity-slice-left: 4; -unity-slice-right: 4; -unity-slice-top: 4; -unity-slice-bottom: 4;
    -unity-slice-scale: 2px;
}

.tech-row--available:hover {
    background-image: url("../Art/UI/ui_row_hover.png");
}

.tech-row--current {
    background-image: url("../Art/UI/ui_row_current.png");
}

.tech-row--done {
    opacity: 0.6;
}

.tech-row--locked {
    opacity: 0.45;
}

.tech-name {
    font-size: 16px;
    color: rgb(250, 230, 170);
}

.tech-desc {
    font-size: 8px;
    color: rgb(214, 200, 176);
    white-space: normal;
    margin-top: 2px;
}

.tech-state {
    font-size: 8px;
    color: rgb(240, 200, 120);
    margin-top: 2px;
}
