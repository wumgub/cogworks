/* Shared pixel-art skin. Images live in Assets/_Game/Art/UI (generated by Tools/art/generate.py).
   9-slice images keep their ornate corners unstretched; -unity-slice-scale doubles the pixel art. */

.skin-root {
    -unity-font-definition: url("../Art/UI/CogworksPixel.ttf");
    font-size: 16px;
    color: rgb(240, 228, 206);
}

.frame-window {
    background-image: url("../Art/UI/ui_window.png");
    -unity-slice-left: 16; -unity-slice-right: 16; -unity-slice-top: 16; -unity-slice-bottom: 16;
    -unity-slice-scale: 2px;
    background-color: rgba(0, 0, 0, 0);
    border-width: 0;
}

.frame-small {
    background-image: url("../Art/UI/ui_frame.png");
    -unity-slice-left: 8; -unity-slice-right: 8; -unity-slice-top: 8; -unity-slice-bottom: 8;
    -unity-slice-scale: 2px;
    background-color: rgba(0, 0, 0, 0);
    border-width: 0;
}

.plaque {
    background-image: url("../Art/UI/ui_plaque.png");
    -unity-slice-left: 8; -unity-slice-right: 8; -unity-slice-top: 5; -unity-slice-bottom: 5;
    -unity-slice-scale: 2px;
    background-color: rgba(0, 0, 0, 0);
    padding: 4px 20px 6px 20px;
    color: rgb(250, 230, 170);
    -unity-text-align: middle-center;
}

/* ---------------------------------------------------------------- buttons */

.pixel-btn, .btn, .action-btn {
    background-image: url("../Art/UI/ui_button.png");
    -unity-slice-left: 6; -unity-slice-right: 6; -unity-slice-top: 6; -unity-slice-bottom: 6;
    -unity-slice-scale: 2px;
    background-color: rgba(0, 0, 0, 0);
    border-width: 0;
    border-radius: 0;
    color: rgb(240, 228, 206);
    font-size: 16px;
    -unity-text-align: middle-center;
    padding: 2px 12px 4px 12px;
}

.pixel-btn:hover, .btn:hover, .action-btn:hover {
    background-image: url("../Art/UI/ui_button_hover.png");
}

.pixel-btn:active, .btn:active, .action-btn:active {
    background-image: url("../Art/UI/ui_button_down.png");
    padding-top: 4px;
    padding-bottom: 2px;
}

.btn--primary, .action-btn {
    background-image: url("../Art/UI/ui_button_primary.png");
    color: rgb(42, 26, 12);
}

.btn--primary:hover, .action-btn:hover {
    background-image: url("../Art/UI/ui_button_primary_hover.png");
}

.btn:disabled {
    background-image: url("../Art/UI/ui_button_disabled.png");
    color: rgb(130, 118, 104);
    opacity: 1;
}

/* ---------------------------------------------------------------- inputs */

.unity-text-field__input, .unity-base-text-field__input, #unity-text-input {
    background-image: url("../Art/UI/ui_field.png");
    -unity-slice-left: 4; -unity-slice-right: 4; -unity-slice-top: 4; -unity-slice-bottom: 4;
    -unity-slice-scale: 2px;
    background-color: rgba(0, 0, 0, 0);
    border-width: 0;
    border-radius: 0;
    color: rgb(246, 232, 200);
    font-size: 16px;
    padding-left: 10px;
}

.unity-text-field:focus .unity-text-field__input,
.unity-base-text-field:focus .unity-base-text-field__input {
    background-image: url("../Art/UI/ui_field_focus.png");
}

.unity-toggle__checkmark {
    background-image: url("../Art/UI/ui_toggle_off.png");
    background-color: rgba(0, 0, 0, 0);
    border-width: 0;
    width: 24px;
    height: 24px;
    -unity-background-image-tint-color: rgb(255, 255, 255);
}

.unity-toggle:checked .unity-toggle__checkmark {
    background-image: url("../Art/UI/ui_toggle_on.png");
}

.unity-base-slider__tracker {
    background-image: url("../Art/UI/ui_slider_track.png");
    -unity-slice-left: 3; -unity-slice-right: 3; -unity-slice-top: 3; -unity-slice-bottom: 3;
    -unity-slice-scale: 2px;
    background-color: rgba(0, 0, 0, 0);
    border-width: 0;
    height: 12px;
    margin-top: -6px;
}

.unity-base-slider__dragger {
    background-image: url("../Art/UI/ui_slider_handle.png");
    background-color: rgba(0, 0, 0, 0);
    border-width: 0;
    border-radius: 0;
    width: 16px;
    height: 24px;
    margin-top: -12px;
}

.unity-scroller__low-button, .unity-scroller__high-button {
    display: none;
}

.unity-scroller--vertical {
    width: 16px;
}

.unity-scroller .unity-base-slider__tracker {
    background-image: url("../Art/UI/ui_scroll_track.png");
    -unity-slice-left: 3; -unity-slice-right: 3; -unity-slice-top: 3; -unity-slice-bottom: 3;
    -unity-slice-scale: 2px;
    width: 16px;
    height: auto;
    margin-top: 0;
    left: 0;
}

.unity-scroller .unity-base-slider__dragger {
    background-image: url("../Art/UI/ui_scroll_thumb.png");
    -unity-slice-left: 3; -unity-slice-right: 3; -unity-slice-top: 3; -unity-slice-bottom: 3;
    -unity-slice-scale: 2px;
    width: 16px;
    margin-top: 0;
    left: 0;
}

/* ---------------------------------------------------------------- headings */

.gear-heading {
    background-image: url("../Art/UI/ui_gear.png");
    background-size: 18px 18px;
    background-repeat: no-repeat;
    background-position-x: left 0px;
    background-position-y: center;
    padding-left: 24px;
    border-bottom-width: 2px;
    border-bottom-color: rgb(110, 80, 40);
}
